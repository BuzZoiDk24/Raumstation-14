<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              Margin="10 10 10 0"
              HorizontalExpand="True"
              Visible="True">
    <PanelContainer StyleClasses="BackgroundPanel" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True">
            <RichTextLabel Name="RewardLabel" HorizontalExpand="True"/>
            <RichTextLabel Name="ManifestLabel" HorizontalExpand="True"/>
            <BoxContainer Orientation="Horizontal" Margin="0 5 0 0">
                <RichTextLabel Name="IdLabel" HorizontalExpand="True"/>
                <Button Name="PrintButton"
                        Text="{Loc 'bounty-console-label-button-text'}"
                        StyleClasses="OpenRight"/>
                <Button Name="SkipButton"
                        Text="{Loc 'bounty-console-skip-button-text'}"
                        StyleClasses="OpenLeft"/>
            </BoxContainer>
            <controls:Separator StyleClasses="LowDivider" Margin="5 10 5 10"/>
            <BoxContainer>
                <RichTextLabel Name="DescriptionLabel" HorizontalExpand="True"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
