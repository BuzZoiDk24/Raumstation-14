# Conjunctions and punctuation for lists assembled by ContentLocalizationManager.
zzzz-fmt-list-and-pair = { $first } and { $last }
zzzz-fmt-list-and-many = { $items }, and { $last }
zzzz-fmt-list-or-pair = { $first } or { $last }
zzzz-fmt-list-or-many = { $items }, or { $last }
zzzz-fmt-list-and-or-pair = { $first } and/or { $last }
zzzz-fmt-list-and-or-many = { $items }, and/or { $last }
