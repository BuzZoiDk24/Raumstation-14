signal-port-name-pressed = Betätigt
signal-port-description-pressed = Sendet ein Signal, wenn der Sender betätigt wird.

signal-port-name-on-transmitter = Ein
signal-port-description-on-transmitter = Sendet ein Signal, wenn der Sender eingeschaltet wird.

signal-port-name-off-transmitter = Aus
signal-port-description-off-transmitter = Sendet ein Signal, wenn der Sender ausgeschaltet wird.

signal-port-name-status-transmitter = Status
signal-port-description-status-transmitter = Sendet je nach Zustand des Senders HIGH oder LOW.

signal-port-name-left = Links
signal-port-description-left = Sendet ein Signal, wenn der Hebel ganz nach links bewegt wird.

signal-port-name-right = Rechts
signal-port-description-right = Sendet ein Signal, wenn der Hebel ganz nach rechts bewegt wird.

signal-port-name-doorstatus = Türzustand
signal-port-description-doorstatus = Sendet HIGH beim Öffnen der Tür und LOW, sobald sie vollständig geschlossen ist.

signal-port-name-doorboltstatus = Türverriegelung
signal-port-description-doorboltstatus = Sendet HIGH, wenn die Tür verriegelt wird, und LOW, wenn die Verriegelung gelöst wird.

signal-port-name-dockstatus = Andockzustand
signal-port-description-dockstatus = Sendet HIGH im angedockten Zustand und LOW im abgedockten Zustand.

signal-port-name-middle = Mitte
signal-port-description-middle = Sendet ein Signal, wenn der Hebel in die Mittelstellung bewegt wird.

signal-port-name-trigger-sender = Auslösen
signal-port-description-trigger-sender = Sendet ein Signal, wenn das Gerät ausgelöst wird.

signal-port-name-timer-trigger = Zeitschaltuhr
signal-port-description-timer-trigger = Sendet ein Signal, wenn die eingestellte Zeit abgelaufen ist.

signal-port-name-timer-start = Countdown gestartet
signal-port-description-timer-start = Sendet ein Signal, wenn der Countdown beginnt.

signal-port-name-logic-output = Ausgang
signal-port-description-logic-output = Sendet abhängig vom ausgewählten Gatter und seinen Eingängen HIGH oder LOW.

signal-port-name-logic-output-high = Steigende Flanke
signal-port-description-logic-output-high = Sendet ein Signal, wenn am Eingang eine steigende Flanke auftritt.

signal-port-name-logic-output-low = Fallende Flanke
signal-port-description-logic-output-low = Sendet ein Signal, wenn am Eingang eine fallende Flanke auftritt.

signal-port-name-air-danger = Gefahr
signal-port-description-air-danger = Sendet HIGH im Gefahrenzustand und andernfalls LOW.

signal-port-name-air-warning = Warnung
signal-port-description-air-warning = Sendet HIGH im Warnzustand und andernfalls LOW.

signal-port-name-air-normal = Normal
signal-port-description-air-normal = Sendet HIGH im Normalzustand und andernfalls LOW.

signal-port-name-decaying = Zerfall
signal-port-description-decaying = Sendet ein Signal, wenn die verbundene Anomalie zu zerfallen beginnt.

signal-port-name-stabilize = Stabilisierung
signal-port-description-stabilize = Sendet ein Signal, wenn die verbundene Anomalie normalisiert wird.

signal-port-name-growing = Wachstum
signal-port-description-growing = Sendet ein Signal, wenn die verbundene Anomalie zu wachsen beginnt.

signal-port-name-pulse = Puls
signal-port-description-pulse = Sendet ein Signal, wenn die verbundene Anomalie pulsiert.

signal-port-name-supercrit = Überkritische Reaktion
signal-port-description-supercrit = Sendet ein Signal, wenn die verbundene Anomalie bei 100 % Intensität eine überkritische Reaktion auslöst.

signal-port-name-power-charging = Wird geladen
signal-port-description-power-charging = Sendet HIGH, wenn die Batterie geladen wird, und andernfalls LOW.

signal-port-name-power-discharging = Wird entladen
signal-port-description-power-discharging = Sendet HIGH, wenn die Batterie entladen wird, und andernfalls LOW.

signal-port-name-item-detected = Erkannt
signal-port-description-item-detected = Sendet ein Signal, wenn der Sender einen Gegenstand erkennt.
