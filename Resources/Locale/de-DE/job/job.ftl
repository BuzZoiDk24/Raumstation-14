job-greet-station-name = Willkommen an Bord der {$stationName}.
job-greet-introduce-job-name = Deine Rolle ist: {$jobName}.
job-greet-important-disconnect-admin-notify = Du spielst einen Job, der wichtig für den Spielfortschritt ist. Wenn du die Verbindung trennen musst, informiere bitte die Admins über ahelp.
job-greet-supervisors-warning = Als {$jobName} unterstehst du direkt {$supervisors}. Besondere Umstände können dies ändern.
