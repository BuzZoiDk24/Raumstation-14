# Items and structures shown in the janitorial guide.

ent-MopItem = Wischmopp
    .gender = masculine
    .desc = Ein unermüdlicher Mopp für die unangenehmsten Flecken.

ent-AdvMopItem = Hochleistungswischmopp
    .gender = masculine
    .desc = Ein motorisierter Wischmopp mit größerem Tank, der andere Flüssigkeiten rasch durch Wasser ersetzt. Clownabwehr nicht inbegriffen.

ent-WetFloorSign = Rutschgefahr-Schild
    .gender = neuter
    .desc = Vorsicht, nasser Boden!

ent-WireBrush = Drahtbürste
    .gender = feminine
    .desc = Eine Bürste aus Stahldraht. Selbst hartnäckiger Rost hat keine Chance.

ent-SoapNT = NanoTrasen-Seife
    .gender = feminine
    .desc = Seife der Marke NanoTrasen. Riecht nach Plasma.

ent-SprayBottleSpaceCleaner = Reinigungsspray
    .gender = neuter
    .desc = Eine Sprühflasche mit schaumfreiem Universalreiniger der Marke BLAM!

ent-TrashBag = Müllsack
    .gender = masculine
    .desc = Für herumliegenden Abfall.

ent-Bucket = Eimer
    .gender = masculine
    .desc = Ein ganz gewöhnlicher Eimer.

ent-LightReplacer = Lampenwechsler
    .gender = masculine
    .desc = Wechselt kaputte Leuchtmittel mithilfe von Magneten aus. Fülle ihn mit neuen Leuchtmitteln auf.

ent-LightReplacerFilled = Lampenwechsler
    .gender = masculine
    .desc = Wechselt kaputte Leuchtmittel mithilfe von Magneten aus. Fülle ihn mit neuen Leuchtmitteln auf.

ent-Sink = Waschbecken
    .gender = neuter
    .desc = Die Wasserhähne sind fest zugedreht und tropfen trotzdem manchmal.

ent-FloorDrain = Bodenabfluss
    .gender = masculine
    .desc = Leitet Flüssigkeiten vom Boden ab. Praktisch zum Entleeren von Wischeimern und zum Trockenhalten von Räumen.

ent-MopBucket = Wischeimer
    .gender = masculine
    .desc = Fasst Wasser und die Tränen des Reinigungspersonals.

ent-JanitorialTrolley = Reinigungswagen
    .gender = masculine
    .desc = Das A und O der Stationsreinigung.

ent-WaterTankFull = Wassertank
    .gender = masculine
    .desc = Ein Tank, in dem sich große Mengen Wasser lagern lassen.

ent-Holoprojector = Holoprojektor
    .gender = masculine
    .desc = Projiziert ein holografisches Warnschild für die Reinigung.

ent-Mousetrap = Mausefalle
    .gender = feminine
    .desc = Hilft gegen Nagetiere, die sich in die Küche schleichen.

ent-BoxLightMixed = Leuchtmittelbox
    .gender = feminine
    .desc = Enthält verschiedene Leuchtmittel für kaputte Lampen.
