ent-WiredApronBase = Schürze mit Kabeln
    .desc = Eine Schürze, durch die Kabel gezogen wurden. Sie sieht unvollständig aus.
    .gender = feminine
    .number = singular

ent-SteelApronBase = Stahlbeplankte Schürze
    .desc = Eine Schürze, an der Stahlplatten mit übrigen Kabeln notdürftig befestigt wurden. Würde in diesem Zustand beim Tragen sofort auseinanderfallen.
    .gender = feminine
    .number = singular
    .name-adjective = stahlbeplankt
    .name-noun = Schürze

ent-WeldedSteelApronBase = Geschweißte Stahlschürze
    .desc = Eine Schürze mit angeschweißten Stahlplatten, die an übrigen Kabeln befestigt sind. Die Rüstung droht nicht mehr auseinanderzufallen, muss aber noch bearbeitet werden, bevor sie sicher sitzt.
    .gender = feminine
    .number = singular
    .name-adjective = geschweißt
    .name-noun = Stahlschürze

ent-ClothingOuterArmorScrap = Schrottrüstung
    .desc = Die glänzende Plattenrüstung eines Grautiders. Rück deine Sachen raus oder du bist erledigt.
