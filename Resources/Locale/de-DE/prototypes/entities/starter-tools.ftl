# Common items a new crew member can encounter during a first shift.

ent-Paper = Blatt Papier
    .name-genitive = Blattes Papier
    .gender = neuter
    .desc = Ein unbeschriebenes Blatt Papier.

ent-Pen = Stift
    .name-genitive = Stifts
    .gender = masculine
    .desc = Ein Stift mit dunkler Tinte.

ent-Crowbar = Brecheisen
    .name-genitive = Brecheisens
    .gender = neuter
    .desc = Damit lassen sich Türen aufhebeln oder Besucher aus anderen Dimensionen verprügeln.

ent-Wirecutter = Seitenschneider
    .name-genitive = Seitenschneiders
    .gender = masculine
    .desc = Damit ist jedes Kabel schnell durch.

ent-Screwdriver = Schraubendreher
    .name-genitive = Schraubendrehers
    .gender = masculine
    .desc = Industrielle Schraubkraft im Taschenformat.

ent-Wrench = Schraubenschlüssel
    .name-genitive = Schraubenschlüssels
    .gender = masculine
    .desc = Ein Werkzeug zum Auf- und Abbauen. Links befestigen, rechts lösen.

ent-Welder = Schweißgerät
    .name-genitive = Schweißgeräts
    .gender = neuter
    .desc = Schmilzt alles, solange genug Brennstoff da ist. Vergiss den Augenschutz nicht!

ent-PaperWrittenSyndicateInstructions = Einsatzhandbuch
    .desc = Ein kurzes Handbuch mit den wichtigsten Anweisungen für deinen neuesten Einsatz. Nach dem Lesen vernichten.
    .gender = neuter
    .number = singular
    .name-genitive = Einsatzhandbuchs

ent-SprayPainterRecharging = Farbsprühgerät
    .desc = Ein Farbsprühgerät zum Lackieren von Luftschleusen, Rohren und anderen Gegenständen.
    .suffix = Adminspielzeug
    .gender = neuter
    .number = singular
    .name-genitive = Farbsprühgeräts
    .plural = Farbsprühgeräte
    .plural-dative = Farbsprühgeräten

ent-SprayPainter = { ent-SprayPainterRecharging }
    .desc = { ent-SprayPainterRecharging.desc }
    .gender = neuter
    .number = singular
    .name-genitive = Farbsprühgeräts
    .plural = Farbsprühgeräte
    .plural-dative = Farbsprühgeräten

ent-SprayPainterBorg = Experimentelles Farbsprühgerät
    .desc = Ein experimentelles Farbsprühgerät, das selbstständig unbegrenzt Druckfarbe nachbilden kann.
    .suffix = Cyborg
    .gender = neuter
    .number = singular
    .name-adjective = experimentell
    .name-noun = Farbsprühgerät
    .name-noun-genitive = Farbsprühgeräts
    .name-noun-plural = Farbsprühgeräte
    .name-noun-plural-dative = Farbsprühgeräten

ent-SprayPainterEmpty = { ent-SprayPainter }
    .desc = { ent-SprayPainter.desc }
    .suffix = Leer
    .gender = neuter
    .number = singular
    .name-genitive = Farbsprühgeräts
    .plural = Farbsprühgeräte
    .plural-dative = Farbsprühgeräten

ent-SprayPainterAmmo = Farbkartusche
    .desc = Eine Kartusche mit stark komprimierter Farbe, wie sie häufig in Farbsprühgeräten verwendet wird.
    .gender = feminine
    .number = singular
    .plural = Farbkartuschen
    .plural-dative = Farbkartuschen
