ent-BorgChassisSyndicateMedical = Syndikats-Medizincyborg
    .desc = Ein Cyborg für die Versorgung im Kampf. Seine Angriffsmöglichkeiten sind begrenzt, doch seine Fähigkeiten zur Unterstützung machen das mehr als wett.
    .gender = masculine
    .name-genitive = Syndikats-Medizincyborgs

ent-BorgChassisSyndicateSaboteur = Syndikats-Sabotagecyborg
