    .gender = masculine
    .name-genitive = Syndikats-Sabotagecyborgs

ent-BorgChassisDerelict = Verfallener Cyborg
    .desc = Ein Hybrid aus Mensch und Maschine, der bei den Aufgaben auf der Station hilft. Dieser hier ist in einem erbärmlichen Zustand.
