ent-WeaponLaserCarbine = Laserkarabiner
    .name-genitive = Laserkarabiners
    .gender = masculine
    .desc = Beim Sicherheitsdienst von NanoTrasen beliebt, weil er günstig und einfach zu bedienen ist.

ent-WeaponRifleLecter = Sturmgewehr Lecter
    .name-genitive = Sturmgewehrs Lecter
    .gender = neuter
    .desc = Ein bewährtes Gasdrucklader-Gewehr, das NanoTrasen und SolGov häufig einsetzen. Es schießt halb- oder vollautomatisch und überzeugt durch Präzision, Durchschlagskraft und Zuverlässigkeit. Verwendet .20-Gewehrmagazine.

ent-WeaponShotgunKammerer = Schrotflinte Kammerer
    .gender = feminine
    .desc = Ein altes, aber zuverlässiges Modell, das irreguläre Truppen auf vielen Welten schätzen. Verwendet .50-Schrotpatronen.
