# Security equipment. Names and descriptions come from the English entity prototypes.

ent-Handcuffs = Handschellen
    .gender = feminine
    .number = plural
    .desc = Damit hältst du Straftäter und andere Ärgernisse fest.

ent-Cablecuffs = Kabelbinderfesseln
    .gender = feminine
    .number = plural
    .desc = Improvisierte Fesseln aus übrig gebliebenen Kabeln.

ent-Stunbaton = Elektroschlagstock
    .name-genitive = Elektroschlagstocks
    .gender = masculine
    .desc = Macht Personen vorübergehend kampfunfähig. Eine ausgeklügelte Handschlaufe verhindert, dass Kadetten ihn versehentlich fallen lassen.

ent-Flash = Blendgerät
    .name-genitive = Blendgeräts
    .gender = neuter
    .desc = Ein handliches Gerät mit Auslöser, das einen grellen Lichtblitz erzeugt. Es blendet und macht benommen, solange die Lampe nicht durchgebrannt ist.

ent-SciFlash = Blendgerät
    .name-genitive = Blendgeräts
    .gender = neuter
    .desc = Ein handliches Gerät mit Auslöser, das einen grellen Lichtblitz erzeugt. Es blendet und macht benommen, solange die Lampe nicht durchgebrannt ist.

ent-PortableFlasher = Mobile Blendfalle
    .name-adjective = mobil
    .name-noun = Blendfalle
    .gender = feminine
    .desc = Ein grelles Blendlicht mit Näherungsauslöser. Damit kannst du einen Bereich absichern.

ent-GrenadeFlashBang = Blendgranate
    .gender = feminine
    .desc = Piiiiiiiiiiiiiiiiiep.

ent-WeaponDisablerPractice = Übungs-Disabler
    .name-genitive = Übungs-Disablers
    .gender = masculine
    .desc = Diese entschärfte Übungswaffe erschöpft organische Ziele. Für Kadetten wurde ihre Wirkung so weit reduziert, dass sie kaum Schaden anrichtet.

ent-WeaponDisabler = Disabler
    .name-genitive = Disablers
    .gender = masculine
    .desc = Eine Selbstverteidigungswaffe, die organische Ziele erschöpft und schwächt, bis sie zusammenbrechen.

ent-WeaponDisablerSMG = Disabler-Maschinenpistole
    .gender = feminine
    .desc = Eine fortschrittliche Waffe, die organische Ziele erschöpft und schwächt, bis sie zusammenbrechen.

ent-ClothingBeltSecurity = Sicherheitsgürtel
    .name-genitive = Sicherheitsgürtels
    .gender = masculine
    .desc = Bietet Platz für Sicherheitsausrüstung wie Handschellen und Blendgeräte.

ent-SecurityPDA = Sicherheits-PDA
    .name-genitive = Sicherheits-PDAs
    .gender = masculine
    .desc = Rot, damit Blutflecken von Passagieren nicht so auffallen.

ent-RadioHandheldSecurity = Sicherheitsfunkgerät
    .name-genitive = Sicherheitsfunkgeräts
    .gender = neuter
    .desc = Ein handliches Funkgerät für den Sicherheitsdienst.

ent-ForensicPad = Spurenpad
    .name-genitive = Spurenpads
    .gender = neuter
    .desc = Damit lassen sich Fingerabdrücke und Fasern aufnehmen.

