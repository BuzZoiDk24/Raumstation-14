# Kommunikationskonsolen und zugehörige Platinen

ent-ComputerComms = Kommunikationskonsole
    .gender = feminine
    .desc = Eine Konsole für stationsweite Durchsagen, die Wahl der Alarmstufe und die Anforderung des Notfallshuttles.

ent-SyndicateComputerComms = Syndikat-Kommunikationskonsole
    .gender = feminine
    .desc = Eine Konsole, die sich aus der Ferne in die Kommunikationssysteme der Station hacken kann. Eine Durchsage verrät der Station deine Anwesenheit.

ent-WizardComputerComms = Magische Kommunikationskonsole
    .gender = feminine
    .desc = Eine Konsole, die deine Worte auf magische Weise an die Station überträgt. Eine Durchsage verrät der Station deine Anwesenheit.

ent-CentcommComputerComms = Kommunikationskonsole des Zentralkommandos
    .gender = feminine
    .desc = Eine Konsole für Durchsagen an alle Stationen. Das überlegene Gegenstück zur gewöhnlichen Kommunikationskonsole.

ent-CommsComputerCircuitboard = Kommunikationsplatine
    .gender = feminine
    .desc = Eine Computerplatine für eine Kommunikationskonsole.

ent-SyndicateCommsComputerCircuitboard = Syndikat-Kommunikationsplatine
    .gender = feminine
    .desc = Eine Computerplatine für eine Kommunikationskonsole des Syndikats.

ent-WizardCommsComputerCircuitboard = Magische Kommunikationsplatine
    .gender = feminine
    .desc = Eine Computerplatine für eine magische Kommunikationskonsole.

ent-CentcommCommsComputerCircuitboard = Kommunikationsplatine des Zentralkommandos
    .gender = feminine
    .desc = Eine Computerplatine für eine Kommunikationskonsole des Zentralkommandos.
