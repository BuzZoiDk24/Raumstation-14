reagent-name-miniozine = Miniozine
reagent-name-ragorium = Ragorium

reagent-desc-miniozine = Eine experimentelle Abwandlung von Cognizine, die viele höhere geistige Fähigkeiten zugunsten unerschütterlicher Treue opfert.
reagent-desc-ragorium = Eine experimentelle Chemikalie, die nicht vernunftbegabte Lebewesen in einen Blutrausch versetzt.

entity-effect-guidebook-dna-imprint = { $chance ->
    [1] Prägt
   *[other] prägt
    } geistig einfachen Lebewesen die zugehörige DNA ein und bindet sie als Gefolgsleute an deren Träger.

entity-effect-guidebook-dna-hunt = { $chance ->
    [1] Versetzt
   *[other] versetzt
    } geistig einfache Lebewesen in einen Blutrausch, in dem sie den Träger der zugehörigen DNA jagen.
