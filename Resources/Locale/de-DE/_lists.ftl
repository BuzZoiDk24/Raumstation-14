# Conjunctions and punctuation for lists assembled by ContentLocalizationManager.
zzzz-fmt-list-and-pair = { $first } und { $last }
zzzz-fmt-list-and-many = { $items } und { $last }
zzzz-fmt-list-or-pair = { $first } oder { $last }
zzzz-fmt-list-or-many = { $items } oder { $last }
zzzz-fmt-list-and-or-pair = { $first } und/oder { $last }
zzzz-fmt-list-and-or-many = { $items } und/oder { $last }
